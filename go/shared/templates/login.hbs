<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login &mdash; edge/cms</title>
  <meta name="robots" content="noindex, nofollow">
  <link rel="preload" href="/assets/fonts/dm-sans.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/style.css?v={{asset_version}}">
  <link rel="stylesheet" href="/assets/admin.css?v={{asset_version}}">
</head>
<body class="login-page">

  <main id="main" class="login-card">
    <h1 class="login-title">edge<span>/</span>cms</h1>
    <p class="login-subtitle">Admin Login</p>

    {{#if error}}
    <div class="login-error" role="alert">{{error}}</div>
    {{/if}}

    <form method="POST" action="/admin/login">
      <div class="login-field">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" placeholder="Enter admin password" autocomplete="current-password" required autofocus>
      </div>
      <button type="submit" class="login-submit">Sign In</button>
    </form>
  </main>

</body>
</html>
