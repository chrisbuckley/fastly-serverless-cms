# Edge CMS — local development environment
# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real values.

# Fastly API token (used by the Fastly CLI for deploys/purges)
FASTLY_API_TOKEN=your-api-token-here

# Compute service ID (from `fastly compute deploy` or Terraform output)
FASTLY_SERVICE_ID=your-compute-service-id-here
