<section class="posts-feed">

  <h1 class="article-title" style="margin-bottom: 2rem;">Posts tagged "{{tag}}"</h1>

  {{#each posts}}
  <article class="post-card">
    {{#if featured_image}}
    <a href="/post/{{slug}}" class="post-card-featured">
      <picture>
        <source type="image/webp"
          srcset="{{featured_image}}?width=480&height=220&fit=cover&format=webp 480w,
                  {{featured_image}}?width=800&height=220&fit=cover&format=webp 800w"
          sizes="(max-width: 640px) 100vw, 680px">
        <img src="{{featured_image}}?width=800&height=220&fit=cover" alt="{{title}}" loading="lazy">
      </picture>
    </a>
    {{/if}}
    <div class="post-card-body">
      <div class="post-card-meta">
        <span>{{format_date created_at}}</span>
        <span class="dot"></span>
        <span>{{reading_time content}} min read</span>
      </div>
      <h2 class="post-card-title">
        <a href="/post/{{slug}}">{{title}}</a>
      </h2>
      <p class="post-card-excerpt">
        {{excerpt}}
      </p>
      <div class="post-card-footer">
        <div class="post-tags">
          {{#each tags}}
          <a href="/tag/{{this}}" class="tag tag-accent">{{this}}</a>
          {{/each}}
        </div>
        <a href="/post/{{slug}}" class="read-more">
          Read
          <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </article>
  {{/each}}

  {{#unless posts}}
  <div class="empty-state" style="display:block;">
    <div class="empty-state-title">No posts found</div>
    <div class="empty-state-text">No posts have been tagged with "{{tag}}" yet.</div>
  </div>
  {{/unless}}

</section>
