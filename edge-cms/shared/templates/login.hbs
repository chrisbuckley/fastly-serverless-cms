<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login &mdash; edge/cms</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,600;0,9..144,700;0,9..144,800;1,9..144,400&family=DM+Sans:ital,wght@0,400;0,500;0,700;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/style.css">
  <style>
    body {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      background: var(--bg);
    }
    .login-card {
      background: var(--bg-card);
      border: 1px solid var(--border-light);
      border-radius: 12px;
      padding: 2.5rem 2.5rem 2rem;
      width: 100%;
      max-width: 380px;
      box-shadow: 0 8px 30px var(--shadow), 0 2px 8px var(--shadow);
      animation: fadeUp 0.5s ease both;
    }
    .login-title {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.5rem;
      text-align: center;
      margin-bottom: 0.35rem;
      letter-spacing: -0.02em;
      font-variation-settings: 'opsz' 36;
    }
    .login-title span {
      color: var(--accent);
    }
    .login-subtitle {
      text-align: center;
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-bottom: 1.75rem;
    }
    .login-error {
      background: var(--terracotta-light);
      color: var(--terracotta);
      font-size: 0.82rem;
      font-weight: 500;
      padding: 0.65rem 1rem;
      border-radius: 6px;
      margin-bottom: 1.25rem;
      text-align: center;
    }
    .login-field {
      margin-bottom: 1.25rem;
    }
    .login-field label {
      display: block;
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--text-muted);
      margin-bottom: 0.4rem;
    }
    .login-field input {
      width: 100%;
      font-family: var(--font-body);
      font-size: 0.9rem;
      color: var(--text);
      background: #ffffff;
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 0.65rem 0.85rem;
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .login-field input:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px rgba(27, 107, 82, 0.1);
    }
    .login-submit {
      width: 100%;
      font-family: var(--font-body);
      font-size: 0.9rem;
      font-weight: 600;
      color: #fff;
      background: var(--accent);
      border: none;
      border-radius: 8px;
      padding: 0.75rem;
      cursor: pointer;
      transition: all 0.2s;
      box-shadow: 0 2px 8px rgba(27, 107, 82, 0.25);
    }
    .login-submit:hover {
      background: var(--accent-hover);
      box-shadow: 0 4px 14px rgba(27, 107, 82, 0.35);
      transform: translateY(-1px);
    }
  </style>
</head>
<body>

  <div class="login-card">
    <div class="login-title">edge<span>/</span>cms</div>
    <div class="login-subtitle">Admin Login</div>

    {{#if error}}
    <div class="login-error">{{error}}</div>
    {{/if}}

    <form method="POST" action="/admin/login">
      <div class="login-field">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" placeholder="Enter admin password" required autofocus>
      </div>
      <button type="submit" class="login-submit">Sign In</button>
    </form>
  </div>

</body>
</html>
