<!-- Metadata Section -->
<form method="POST" action="{{#if editing}}/admin/posts/{{post.slug}}{{else}}/admin/posts{{/if}}">
  {{#if editing}}<input type="hidden" name="_method" value="PUT">{{/if}}

  <section class="metadata">
    <div class="metadata-grid">

      <!-- Title -->
      <div class="field field-full field-title">
        <label for="post-title">Title</label>
        <input type="text" id="post-title" name="title" placeholder="Post title..." value="{{#if editing}}{{post.title}}{{/if}}">
      </div>

      <!-- Slug -->
      <div class="field field-slug">
        <label for="post-slug">Slug</label>
        <div style="position: relative;">
          <span class="slug-prefix">/post/</span>
          <input type="text" id="post-slug" name="slug" value="{{#if editing}}{{post.slug}}{{/if}}" placeholder="auto-generated-from-title">
        </div>
      </div>

      <!-- Status -->
      <div class="field">
        <label for="post-status">Status</label>
        <select id="post-status" name="status">
          <option value="draft" {{#if editing}}{{#if (eq post.status "draft")}}selected{{/if}}{{else}}selected{{/if}}>Draft</option>
          <option value="published" {{#if editing}}{{#if (eq post.status "published")}}selected{{/if}}{{/if}}>Published</option>
        </select>
      </div>

      <!-- Tags -->
      <div class="field field-full">
        <label>Tags</label>
        <div class="tags-input-wrapper" id="tags-wrapper">
          {{#if editing}}
          {{#each post.tags}}
          <span class="tag-pill">{{this}} <span class="tag-pill-remove" data-tag="{{this}}">&times;</span></span>
          {{/each}}
          {{/if}}
          <input type="text" class="tags-input" id="tags-input" placeholder="Add a tag and press Enter...">
        </div>
        <input type="hidden" id="tags-hidden" name="tags" value="{{#if editing}}{{post.tags}}{{/if}}">
      </div>

      <!-- Excerpt -->
      <div class="field field-full">
        <label for="post-excerpt">Excerpt</label>
        <textarea id="post-excerpt" name="excerpt" rows="2" placeholder="A short summary for listing pages...">{{#if editing}}{{post.excerpt}}{{/if}}</textarea>
      </div>

      <!-- Featured Image -->
      <div class="field field-full">
        <label>Featured Image</label>
        <div class="image-upload-zone" id="image-upload">
          <svg class="image-upload-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
            <circle cx="8.5" cy="8.5" r="1.5"/>
            <polyline points="21 15 16 10 5 21"/>
          </svg>
          <div class="image-upload-text">
            <strong>Click to upload</strong> or drag and drop
          </div>
          <div class="image-upload-hint">PNG, JPG, or WebP up to 5MB. Images are optimized on the fly via Fastly Image Optimizer.</div>
        </div>
        <input type="hidden" id="featured-image-hidden" name="featured_image" value="{{#if editing}}{{post.featured_image}}{{/if}}">
      </div>

    </div>
  </section>

  <!-- Editor Section (Split Pane) -->
  <section class="editor-section">

    <div class="editor-tabs">
      <div class="editor-tab active">
        <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
        Editor
      </div>
      <div class="editor-tab-spacer"></div>
      <div class="editor-tab-info">
        <span class="dot"></span>
        Auto-saved
      </div>
    </div>

    <div class="editor-panes">

      <!-- Markdown Editor -->
      <div class="editor-pane">
        <div class="editor-pane-header">
          <span class="editor-pane-title">Markdown</span>
          <span class="editor-pane-lang">CommonMark</span>
        </div>
        <div class="editor-textarea-wrapper">
          <div class="editor-line-numbers" id="line-numbers" aria-hidden="true"></div>
          <textarea class="editor-textarea" id="markdown-editor" name="content" spellcheck="false" placeholder="Start writing in Markdown...">{{#if editing}}{{post.content}}{{/if}}</textarea>
        </div>
      </div>

      <!-- Divider -->
      <div class="pane-divider" id="pane-divider"></div>

      <!-- Preview Pane -->
      <div class="preview-pane">
        <div class="preview-pane-header">
          <span class="preview-pane-title">Preview</span>
          <span class="preview-pane-badge">Reader View</span>
        </div>
        <div class="preview-content" id="preview-content">
        </div>
      </div>

    </div>
  </section>

  <!-- Action Bar -->
  <div class="action-bar" style="padding:1rem 0 1.5rem; max-width:none;">
    <div class="action-bar-left">
      <button type="submit" class="btn btn-primary">
        <svg viewBox="0 0 24 24"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
        {{#if editing}}Update Post{{else}}Save Draft{{/if}}
      </button>
    </div>
    {{#if editing}}
    <div class="action-bar-right">
      <button type="button" class="btn btn-danger" onclick="if(confirm('Delete this post? This cannot be undone.')){var f=document.createElement('form');f.method='POST';f.action='/admin/posts/{{post.slug}}';var m=document.createElement('input');m.type='hidden';m.name='_method';m.value='DELETE';f.appendChild(m);document.body.appendChild(f);f.submit();}">
        <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
        Delete
      </button>
    </div>
    {{/if}}
  </div>

</form>
