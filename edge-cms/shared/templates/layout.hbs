<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{#if page_title}}{{page_title}} &mdash; {{/if}}edge/cms</title>
  {{#if og_title}}
  <meta property="og:title" content="{{og_title}}">
  <meta property="og:type" content="{{#if og_type}}{{og_type}}{{else}}website{{/if}}">
  {{#if og_description}}<meta property="og:description" content="{{og_description}}">{{/if}}
  {{#if og_image}}<meta property="og:image" content="{{og_image}}">{{/if}}
  {{#if og_url}}<meta property="og:url" content="{{og_url}}">{{/if}}
  <meta name="twitter:card" content="{{#if og_image}}summary_large_image{{else}}summary{{/if}}">
  <meta name="twitter:title" content="{{og_title}}">
  {{#if og_description}}<meta name="twitter:description" content="{{og_description}}">{{/if}}
  {{#if og_image}}<meta name="twitter:image" content="{{og_image}}">{{/if}}
  {{/if}}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,600;0,9..144,700;0,9..144,800;1,9..144,400&family=DM+Sans:ital,wght@0,400;0,500;0,700;1,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/style.css">
</head>
<body>

  {{#unless is_admin}}
  <!-- Reader header -->
  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="site-title">edge<span>/</span>cms</a>
      <nav class="header-nav">
        <a href="/">Home</a>
        <a href="/tag/fastly">Fastly</a>
        <a href="/tag/edge">Edge</a>
        <a href="/feed.xml" class="nav-rss">
          <svg viewBox="0 0 24 24"><circle cx="6.18" cy="17.82" r="2.18"/><path d="M4 4.44A15.56 15.56 0 0 1 19.56 20"/><path d="M4 11.22A8.78 8.78 0 0 1 12.78 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          RSS
        </a>
      </nav>
    </div>
  </header>
  {{else}}
  <!-- Admin top bar -->
  <header class="topbar">
    <div class="topbar-left">
      <a href="/admin" class="topbar-logo">edge<span>/</span>cms</a>
      <div class="topbar-divider"></div>
      <span class="topbar-label">{{#if admin_label}}{{admin_label}}{{else}}Admin Dashboard{{/if}}</span>
    </div>
    <div class="topbar-right">
      <a href="/" class="topbar-link" target="_blank">
        <svg viewBox="0 0 24 24"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        View Blog
      </a>
      <form method="POST" action="/admin/logout" style="display:inline;">
        <button type="submit" class="topbar-logout">Logout</button>
      </form>
    </div>
  </header>
  {{/unless}}

  {{#unless is_admin}}
  <!-- Reader main layout (two-column with sidebar) -->
  <main class="main-layout">
    {{{body}}}
    {{> _sidebar}}
  </main>
  {{else}}
  <!-- Admin main layout -->
  <main class="admin-main">
    {{{body}}}
  </main>
  {{/unless}}

  {{#unless is_admin}}
  <!-- Reader footer -->
  <footer class="site-footer">
    <div class="footer-inner">
      <div class="footer-edge">
        <span class="pop-dot"></span>
        Served from Fastly's edge (<span id="footer-pop">—</span>)
      </div>
      <div class="footer-links">
        <a href="/sitemap.xml">Sitemap</a>
        <a href="/feed.xml">RSS Feed</a>
        <a href="https://github.com">Source Code</a>
      </div>
    </div>
  </footer>
  {{/unless}}

  {{#if is_admin}}<script src="/assets/admin.js"></script>{{/if}}
</body>
</html>
