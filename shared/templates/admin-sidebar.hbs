<!-- Sidebar Management -->
<div class="page-header">
  <h1 class="sidebar-manager-title">Sidebar Management</h1>
  <a href="/admin" class="back-link">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 18l-6-6 6-6"/></svg>
    Back to Dashboard
  </a>
</div>

<div class="alert alert-error" id="sidebar-error" role="alert" hidden></div>
<p class="field-status" id="sidebar-status" role="status" aria-live="polite"></p>

<!-- Current items list -->
<div class="sidebar-manager mb-lg">
  <div class="sidebar-manager-header">
    <h2 class="sidebar-manager-title">Current Items</h2>
  </div>
  <ul class="sidebar-preview" id="sidebar-items">
    {{#each sidebar.items}}
    <li class="sidebar-preview-item" data-index="{{@index}}" data-type="{{type}}" data-label="{{label}}" data-slug="{{slug}}" data-children="{{children_csv}}" data-url="{{url}}" data-icon="{{icon}}">
      {{#if is_category}}
      <div class="sidebar-preview-icon sidebar-preview-icon-cat">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
      </div>
      <span class="sidebar-preview-label">{{label}}</span>
      <span class="sidebar-preview-detail">category</span>
      {{else}}
      <div class="sidebar-preview-icon sidebar-preview-icon-link">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
      </div>
      <span class="sidebar-preview-label">{{label}}</span>
      <span class="sidebar-preview-detail">link &middot; {{url}}</span>
      {{/if}}
      <div class="action-icons ml-auto">
        <button type="button" class="action-btn action-btn-edit" title="Edit item" aria-label="Edit {{label}}" data-action="edit">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
        </button>
        <button type="button" class="action-btn action-btn-delete" title="Remove item" aria-label="Remove {{label}}" data-action="remove">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
        </button>
      </div>
    </li>
    {{/each}}
  </ul>
</div>

<!-- Add new items -->
<div class="bottom-section">

  <!-- Add category -->
  <div class="sidebar-manager">
    <div class="sidebar-manager-header">
      <h2 class="sidebar-manager-title">Add Category</h2>
    </div>
    <div class="form-stack">
      <div class="field">
        <label for="new-cat-label">Label</label>
        <input type="text" id="new-cat-label" placeholder="e.g. Getting Started" maxlength="100">
      </div>
      <div class="field">
        <label for="new-cat-slug">Slug</label>
        <input type="text" id="new-cat-slug" placeholder="e.g. getting-started" maxlength="100">
      </div>
      <div class="field">
        <label for="new-cat-children">Post Slugs (comma-separated)</label>
        <input type="text" id="new-cat-children" placeholder="e.g. my-first-post, setup-guide">
      </div>
      <button type="button" class="btn btn-primary self-start" id="add-category-btn">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        <span class="btn-label">Add Category</span>
      </button>
    </div>
  </div>

  <!-- Add link -->
  <div class="sidebar-manager">
    <div class="sidebar-manager-header">
      <h2 class="sidebar-manager-title">Add Link</h2>
    </div>
    <div class="form-stack">
      <div class="field">
        <label for="new-link-label">Label</label>
        <input type="text" id="new-link-label" placeholder="e.g. GitHub Repository" maxlength="100">
      </div>
      <div class="field">
        <label for="new-link-url">URL</label>
        <input type="text" id="new-link-url" placeholder="e.g. https://github.com/..." aria-describedby="new-link-url-hint">
        <p class="field-hint" id="new-link-url-hint">Must start with https://, http:// or a single /</p>
      </div>
      <div class="field">
        <label for="new-link-icon">Icon (optional)</label>
        <select id="new-link-icon">
          <option value="">Default (external link)</option>
          <option value="github">GitHub</option>
          <option value="book">Book / Docs</option>
          <option value="code">Code / Developer</option>
        </select>
      </div>
      <button type="button" class="btn btn-primary self-start" id="add-link-btn">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        <span class="btn-label">Add Link</span>
      </button>
    </div>
  </div>

</div>

<!-- Save button -->
<div class="save-bar">
  <button type="button" class="btn btn-primary" id="save-sidebar-btn">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
    <span class="btn-label">Save Sidebar</span>
  </button>
</div>
