<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{#if page_title}}{{page_title}} &mdash; {{/if}}edge/cms</title>
  <meta name="description" content="{{meta_description}}">
  <link rel="canonical" href="{{canonical_url}}">
  {{#if noindex}}<meta name="robots" content="noindex, nofollow">{{/if}}
  <meta property="og:site_name" content="edge/cms">
  <meta property="og:title" content="{{page_title}}">
  <meta property="og:type" content="{{#if og_type}}{{og_type}}{{else}}website{{/if}}">
  <meta property="og:description" content="{{meta_description}}">
  <meta property="og:url" content="{{canonical_url}}">
  {{#if og_image}}<meta property="og:image" content="{{og_image}}">{{/if}}
  <meta name="twitter:card" content="{{#if og_image}}summary_large_image{{else}}summary{{/if}}">
  <meta name="twitter:title" content="{{page_title}}">
  <meta name="twitter:description" content="{{meta_description}}">
  {{#if og_image}}<meta name="twitter:image" content="{{og_image}}">{{/if}}
  <link rel="alternate" type="application/rss+xml" title="edge/cms" href="/feed.xml">
  <link rel="preload" href="/assets/fonts/dm-sans.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/style.css?v={{asset_version}}">
  {{#if is_admin}}<link rel="stylesheet" href="/assets/admin.css?v={{asset_version}}">{{/if}}
  {{#if is_admin}}
  <script src="/assets/admin.js?v={{asset_version}}" defer></script>
  {{else}}
  <script src="/assets/site.js?v={{asset_version}}" defer></script>
  {{/if}}
</head>
<body>
  <a class="skip-link" href="#main">Skip to main content</a>

  {{#unless is_admin}}
  <!-- Reader header -->
  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="site-title">edge<span>/</span>cms</a>
      <nav class="header-nav" aria-label="Primary">
        <a href="/">Home</a>
        <a href="/feed.xml" class="nav-rss">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="6.18" cy="17.82" r="2.18"/><path d="M4 4.44A15.56 15.56 0 0 1 19.56 20"/><path d="M4 11.22A8.78 8.78 0 0 1 12.78 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          RSS
        </a>
        <a href="/sitemap.xml">Sitemap</a>
      </nav>
    </div>
  </header>
  {{else}}
  <!-- Admin top bar -->
  <header class="topbar">
    <div class="topbar-left">
      <a href="/admin" class="topbar-logo">edge<span>/</span>cms</a>
      <div class="topbar-divider"></div>
      <span class="topbar-label">{{#if admin_label}}{{admin_label}}{{else}}Admin Dashboard{{/if}}</span>
    </div>
    <nav class="topbar-right" aria-label="Admin">
      <a href="/" class="topbar-link" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        View Blog<span class="sr-only"> (opens in a new tab)</span>
      </a>
      <form method="POST" action="/admin/logout" class="topbar-form">
        <button type="submit" class="topbar-logout">Logout</button>
      </form>
    </nav>
  </header>
  {{/unless}}

  {{#unless is_admin}}
  <!-- Reader main layout (two-column with sidebar) -->
  <div class="main-layout">
    <main id="main" class="main-content" tabindex="-1">
      {{{body}}}
    </main>
    {{> _sidebar}}
  </div>
  {{else}}
  <!-- Admin main layout -->
  <main id="main" class="admin-main" tabindex="-1">
    {{{body}}}
  </main>
  {{/unless}}

  {{#unless is_admin}}
  <!-- Reader footer -->
  <footer class="site-footer">
    <div class="footer-inner">
      <div class="footer-edge">
        <span class="pop-dot" aria-hidden="true"></span>
        Served from Fastly's edge (<span id="footer-pop">&mdash;</span>)
      </div>
      <nav class="footer-links" aria-label="Footer">
        <a href="/sitemap.xml">Sitemap</a>
        <a href="/feed.xml">RSS Feed</a>
        <a href="https://github.com/chrisbuckley/fastly-serverless-cms">Source Code</a>
      </nav>
    </div>
  </footer>
  {{/unless}}
</body>
</html>
